programa
{
	
	funcao inicio()
	{
		real valor1, valor2, resultado
		
		escreva("Informe o primeiro valor: ")
		leia(valor1)

		faca
		{ 
			escreva("\nInforme o segundo valor: ")
			leia(valor2)
			se (valor2 == 0)
			{
			escreva("\nVALOR INVÁLIDO")
			}
		}
		enquanto (valor2 == 0)

		resultado = valor1 / valor2

		escreva("\nResultado da divisão: ", resultado)
		
		
	}
}

