programa
{
	
	funcao inicio()
	{
		real fahrenheit, celsius

		escreva("Digite a temperatura em Fahreinheit: ")
		leia(fahrenheit)

		celsius = (fahrenheit - 32) * 5 / 9
		
		escreva("O valor em graus Celcius é: ", celsius)
		
	}
}
